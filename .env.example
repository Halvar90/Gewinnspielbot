# Railway setzt DATABASE_URL automatisch, wenn Postgres im Projekt haengt
DATABASE_URL=postgresql://user:pass@host:5432/railway

# Telegram (von @BotFather bzw. @userinfobot)
TELEGRAM_TOKEN=
TELEGRAM_CHAT_ID=

# Geheimer Pfad fuer den MCP-Server. Lange Zufallszeichenfolge waehlen!
# Der Connector-URL lautet dann: https://<railway-domain>/mcp/<MCP_SECRET>
MCP_SECRET=

# Optional: Brave Search API fuer die Entdecker-Schicht (spaeter)
BRAVE_API_KEY=
